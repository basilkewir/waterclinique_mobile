# ── API Configuration ─────────────────────────────────────────────────────────
# Backend API URL (in production, use the https URL below)
# EXPO_PUBLIC_API_URL=http://192.168.20.42:8001/api
# EXPO_PUBLIC_API_URL=https://watercliniq.com/api

# ── Sentry ────────────────────────────────────────────────────────────────────
# EXPO_PUBLIC_SENTRY_DSN=https://example@sentry.example.com/1

# ── Google Cloud Vision API Key (optional) ────────────────────────────────────
# The backend automatically runs Google Vision analysis using its own key.
# This env var is ONLY needed if you want the mobile app to call Vision
# directly for a faster UX (container verification before upload).
# DO NOT ship this in production builds — rely on the backend instead.
# EXPO_PUBLIC_GOOGLE_VISION_API_KEY=AIzaSy...

# ── Direct AI API Keys (fallback — optional) ─────────────────────────────────
# These keys are used when the backend AI provider is unavailable.
# Normally the backend handles all AI analysis using its configured providers.
# EXPO_PUBLIC_OPENAI_API_KEY=sk-...
# EXPO_PUBLIC_CLAUDE_API_KEY=sk-ant-...
